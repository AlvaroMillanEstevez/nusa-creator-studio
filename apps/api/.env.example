APP_NAME="Nusa Creator Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=nusa_creator
DB_USERNAME=nusa
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=local
MEDIA_MAX_SIZE_KB=51200
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@nusa.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=your-minio-access-key
AWS_SECRET_ACCESS_KEY=your-minio-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=nusa-creator
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_URL=http://127.0.0.1:9000/nusa-creator
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Voiceover provider configuration. Real providers are disabled by default.
VOICEOVER_PROVIDER=mock
VOICEOVER_REAL_ENABLED=false
VOICEOVER_REAL_INTERNAL_ONLY=true
VOICEOVER_MAX_CHARACTERS=1000
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_DEFAULT_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_HIGH_QUALITY_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TIMEOUT_SECONDS=60
ELEVENLABS_FLASH_COST_PER_1K_CHARS=0.05
ELEVENLABS_MULTILINGUAL_COST_PER_1K_CHARS=0.10

# Affiliate campaign provider configuration. Real providers are disabled by default.
CAMPAIGN_PROVIDER=mock
CAMPAIGN_REAL_ENABLED=false
CAMPAIGN_REAL_INTERNAL_ONLY=true
CAMPAIGN_MAX_INPUT_CHARACTERS=4000
CAMPAIGN_MAX_OUTPUT_TOKENS=2500
OPENAI_API_KEY=
OPENAI_CAMPAIGN_MODEL=gpt-5.4-nano
OPENAI_CAMPAIGN_FALLBACK_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
OPENAI_CAMPAIGN_INPUT_COST_PER_1M_TOKENS=
OPENAI_CAMPAIGN_OUTPUT_COST_PER_1M_TOKENS=

VIDEO_TO_CAMPAIGN_PROVIDER=mock
VIDEO_TO_CAMPAIGN_REAL_ENABLED=false
VIDEO_TO_CAMPAIGN_REAL_INTERNAL_ONLY=true
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_VIDEO_MAX_FILE_SIZE_MB=50
GEMINI_VIDEO_MAX_DURATION_SECONDS=60
GEMINI_VIDEO_REQUEST_TIMEOUT_SECONDS=180
GEMINI_VIDEO_FILE_PROCESSING_TIMEOUT_SECONDS=120
GEMINI_VIDEO_FILE_PROCESSING_POLL_INTERVAL_SECONDS=3
GEMINI_VIDEO_DEBUG_RESPONSE_LOG=false
GEMINI_VIDEO_INPUT_USD_PER_1M_TOKENS=
GEMINI_VIDEO_OUTPUT_USD_PER_1M_TOKENS=


# AI Fashion Try-On provider configuration. Real FASHN rendering is disabled by default.
FASHION_TRY_ON_PROVIDER=mock
FASHION_TRY_ON_REAL_ENABLED=false
FASHION_TRY_ON_REAL_INTERNAL_ONLY=true
FASHION_TRY_ON_PUBLIC_ENABLED=true
FASHION_TRY_ON_STANDARD_CREDIT_COST=
FASHION_TRY_ON_PREMIUM_CREDIT_COST=
FASHION_TRY_ON_PREMIUM_FAST_CREDIT_COST=
FASHION_TRY_ON_PREMIUM_BALANCED_CREDIT_COST=
FASHION_TRY_ON_PREMIUM_QUALITY_CREDIT_COST=
FASHN_API_KEY=
FASHN_BASE_URL=https://api.fashn.ai/v1
FASHN_STANDARD_ENABLED=true
FASHN_STANDARD_MODEL=tryon-v1.6
FASHN_STANDARD_MODE=balanced
FASHN_STANDARD_CATEGORY=auto
FASHN_STANDARD_GARMENT_PHOTO_TYPE=auto
FASHN_STANDARD_SEGMENTATION_FREE=true
FASHN_PREMIUM_ENABLED=false
FASHN_PREMIUM_MODEL=tryon-max
FASHN_PREMIUM_DEFAULT_RESOLUTION=1k
FASHN_PREMIUM_DEFAULT_GENERATION_MODE=fast
FASHN_MODERATION_LEVEL=permissive
FASHN_OUTPUT_FORMAT=png
FASHN_RETURN_BASE64=true
FASHN_CONNECT_TIMEOUT_SECONDS=30
FASHN_REQUEST_TIMEOUT_SECONDS=120
FASHN_POLL_INTERVAL_SECONDS=3
FASHN_MAX_POLL_ATTEMPTS=60
FASHN_ESTIMATED_COST_USD_PER_CREDIT=0.075

# Motion AI Video provider configuration. Real rendering is disabled by default.
MOTION_AI_VIDEO_PROVIDER=mock
MOTION_AI_VIDEO_REAL_ENABLED=false
MOTION_AI_VIDEO_REAL_INTERNAL_ONLY=true
GOOGLE_VEO_API_KEY=
GOOGLE_VEO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_VEO_MODEL=veo-3.1-generate-preview
GOOGLE_VEO_REQUEST_MODE=text_only
GOOGLE_VEO_IMAGE_REFERENCES_ENABLED=false
GOOGLE_VEO_IMAGE_TO_VIDEO_ENABLED=false
GOOGLE_VEO_ALLOW_EXPERIMENTAL_IMAGE_INPUT=false
GOOGLE_VEO_DEFAULT_DURATION_SECONDS=8
GOOGLE_VEO_DEFAULT_ASPECT_RATIO=9:16
GOOGLE_VEO_MAX_REFERENCE_IMAGES=3
GOOGLE_VEO_CONNECT_TIMEOUT_SECONDS=60
GOOGLE_VEO_TIMEOUT_SECONDS=300
GOOGLE_VEO_REQUEST_TIMEOUT_SECONDS=180
GOOGLE_VEO_RETRY_TIMES=2
GOOGLE_VEO_RETRY_SLEEP_MS=1500
GOOGLE_VEO_FORCE_IPV4=false
GOOGLE_VEO_FORCE_HTTP1=false
GOOGLE_VEO_POLL_INTERVAL_SECONDS=5
GOOGLE_VEO_MAX_POLL_ATTEMPTS=120
GOOGLE_VEO_SDK_PROCESS_TIMEOUT_SECONDS=900
GOOGLE_VEO_SDK_POLL_INTERVAL_SECONDS=10
GOOGLE_VEO_ESTIMATED_COST_USD_PER_SECOND=

# Auto Video Ads provider configuration. Real rendering is disabled by default.
AUTO_VIDEO_AD_PROVIDER=mock
AUTO_VIDEO_AD_REAL_ENABLED=false
AUTO_VIDEO_AD_REAL_INTERNAL_ONLY=true

# Auto Video Editor provider configuration. Real rendering is disabled by default.
AUTO_VIDEO_EDITOR_PROVIDER=mock
AUTO_VIDEO_EDITOR_REAL_ENABLED=false
AUTO_VIDEO_EDITOR_REAL_INTERNAL_ONLY=true
SHOTSTACK_API_KEY=
SHOTSTACK_BASE_URL=https://api.shotstack.io
SHOTSTACK_ENV=stage
SHOTSTACK_RENDER_TIMEOUT_SECONDS=600
SHOTSTACK_RENDER_POLL_INTERVAL_SECONDS=5
SHOTSTACK_RENDER_MAX_POLL_ATTEMPTS=120
SHOTSTACK_ESTIMATED_RENDER_COST_USD=

# Public base URL used only for provider asset fetches.
# For local testing, point this to an HTTPS ngrok/cloudflared tunnel for the Laravel API.
PROVIDER_ASSET_PUBLIC_BASE_URL=
PROVIDER_ASSET_URL_TTL_MINUTES=30
