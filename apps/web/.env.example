# Nusa Creator Studio web app - example environment.
#
# Copy to .env.local. Every VITE_* variable is embedded in the public JS bundle,
# so never put secrets or API keys here: provider keys live only in apps/api/.env.

# Base URL of the Laravel API, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1
